GROQ_API_KEY=
LANGSMITH_API_KEY=

# Optional live diagnostics. Keep false for ordinary repair, tests, and local development.
TRACEFIX_LANGSMITH_DIAGNOSTICS=false
# Framework auto-tracing must remain disabled; TraceFix emits manual safe spans only.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tracefix-live-diagnostics
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
MODEL_REASONING_EFFORT=low
MODEL_MAX_TOKENS=4096
PROMPT_VERSION=repair-v1.0

MODEL_REQUEST_TIMEOUT_SECONDS=

MODEL_INPUT_PRICE_USD_PER_MILLION_TOKENS=
MODEL_OUTPUT_PRICE_USD_PER_MILLION_TOKENS=
